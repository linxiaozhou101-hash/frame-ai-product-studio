# 必填：北京地域百炼 API Key。仅在本地 .env 或环境变量配置。
DASHSCOPE_API_KEY=

# 当前适配器实现显式蒙版局部重绘，只支持以下模型。
DASHSCOPE_MODEL=wanx2.1-imageedit

# 也支持 https://你的WorkspaceId.cn-beijing.maas.aliyuncs.com
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
POLL_INTERVAL_SECONDS=2
TASK_TIMEOUT_SECONDS=180
REQUEST_TIMEOUT_SECONDS=30

# 可选；不设置时使用项目 work/models，首次自动下载分割模型。
# U2NET_HOME=/absolute/path/to/models
